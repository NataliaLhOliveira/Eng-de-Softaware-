
#include <stdio.h>

int main() {
    double popA = 80000, popB = 100000;
    int anos = 0;

    while (popA <= popB) {
        popA = popA * 1.03;
        popB = popB * 1.015;
        anos++;
    }

    printf("Anos necessarios: %d\n", anos);
    printf("Populacao do pais A: %.0f\n", popA);
    printf("Populacao do pais B: %.0f\n", popB);

    return 0;
}

#include <stdio.h>

int main() {
    float a, b, c;

    printf("Digite o comprimento do lado A: ");
    scanf("%f", &a);

    printf("Digite o comprimento do lado B: ");
    scanf("%f", &b);

    printf("Digite o comprimento do lado C: ");
    scanf("%f", &c);

    if (a < b + c && b < a + c && c < a + b) {
        printf("\nOs lados FORMAM um triangulo.\n");

        if (a == b && b == c) {
            printf("Classificacao: EQUILATERO\n");
        }
        else if (a == b || a == c || b == c) {
            printf("Classificacao: ISOSCELES\n");
        }
        else {
            printf("Classificacao: ESCALENO\n");
        }
    }
    else {
        printf("\nOs lados NAO formam um triangulo (poligono fechado).\n");
    }

    return 0;
}

#include <stdio.h>

int main() {
    float consumo, tarifa, subtotal, total;
    float iluminacao = 15.00;

    printf("Digite o consumo mensal (kWh): ");
    scanf("%f", &consumo);

    if (consumo <= 100) {
        tarifa = 0.40;
    }
    else if (consumo <= 250) {
        tarifa = 0.65;
    }
    else {
        tarifa = 0.90;
    }

    subtotal = consumo * tarifa;
    total = subtotal + iluminacao;

    printf("\nTarifa aplicada: R$ %.2f por kWh\n", tarifa);
    printf("Valor do consumo: R$ %.2f\n", subtotal);
    printf("Iluminacao publica: R$ %.2f\n", iluminacao);
    printf("TOTAL DA FATURA: R$ %.2f\n", total);

    return 0;
}

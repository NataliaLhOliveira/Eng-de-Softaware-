#include <stdio.h>

int main() {
    int ano;

    printf("Digite um ano (4 digitos): ");
    scanf("%d", &ano);

    if ((ano % 4 == 0 && ano % 100 != 0) || (ano % 400 == 0)) {
        printf("\nO ano %d e BISSEXTO\n", ano);
    }
    else {
        printf("\nO ano %d NAO e bissexto\n", ano);
    }

    return 0;
}

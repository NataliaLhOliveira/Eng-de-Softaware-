#include <stdio.h>

int main() {
    int idade, contribuicao;

    printf("Digite a idade: ");
    scanf("%d", &idade);

    printf("Digite o tempo de contribuicao (em anos): ");
    scanf("%d", &contribuicao);

    if (idade >= 65 || contribuicao >= 35) {
        printf("\nAPOSENTADORIA AUTORIZADA\n");
    }
    else {
        printf("\nAPOSENTADORIA REJEITADA: requisitos nao preenchidos\n");
    }

    return 0;
}
